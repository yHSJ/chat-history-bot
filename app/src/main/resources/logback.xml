<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="fi.sundae.chathistory" level="${LOG_LEVEL:-INFO}"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
